APP_NAME=Deploy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Allow self-service user registration. Set to false for a private deployment.
REGISTRATION_ENABLED=false

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Deployments run on a queue worker (`php artisan queue:work`). The `sync`
# driver would block the webhook request until the deployment finishes.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Maximum seconds a single deployment may run before it is marked failed.
DEPLOY_TIMEOUT=3600

# Token used to clone private repositories in Docker deploy steps (e.g. a
# GitHub fine-grained PAT with contents:read). Clone URLs are always built
# server-side; leave empty if all deployed repositories are public.
DEPLOY_GIT_TOKEN=
# DEPLOY_GIT_BASE=https://github.com
# DEPLOY_COMPOSE_FILE=/srv/server-config/apps/{app}/compose.yml

# Run `php artisan migrate --force --isolated` on container start (production
# entrypoint), so updating the app is just pulling a new image.
AUTO_MIGRATE=1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
