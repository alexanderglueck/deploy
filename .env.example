APP_NAME=Deploy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Allow self-service user registration. Set to false for a private deployment.
REGISTRATION_ENABLED=false

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=secret

# Set to "reverb" (with the REVERB_ block below) for realtime dashboard
# updates; with "null" everything degrades to polling.
BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
# Deployments run on a queue worker (`php artisan queue:work`). The `sync`
# driver would block the webhook request until the deployment finishes.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Maximum seconds a single deployment may run before it is marked failed.
DEPLOY_TIMEOUT=3600

# Token used to clone private repositories in Docker deploy steps (e.g. a
# GitHub fine-grained PAT with contents:read). Clone URLs are always built
# server-side; leave empty if all deployed repositories are public.
DEPLOY_GIT_TOKEN=
# DEPLOY_GIT_BASE=https://github.com
# Username paired with the token in the clone URL: x-access-token on GitHub,
# oauth2 on GitLab. A project hosted elsewhere can override all three on itself.
# DEPLOY_GIT_TOKEN_USER=x-access-token
# DEPLOY_COMPOSE_FILE=/srv/server-config/apps/{app}/compose.yml

# Run `php artisan migrate --force --isolated` on container start (production
# entrypoint), so updating the app is just pulling a new image.
AUTO_MIGRATE=1

# Optional: JSON POST to this URL whenever a deployment fails (ntfy, Slack
# webhook, healthchecks.io, ...).
DEPLOY_NOTIFY_URL=

# Concluded deployments (and their logs) older than this are pruned.
DEPLOY_RETENTION_DAYS=100

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Reverb websockets. REVERB_HOST/PORT/SCHEME is where THIS APP delivers
# events (the reverb container on the compose network); REVERB_CLIENT_* is
# where BROWSERS connect (shared with the frontend at runtime). The dev
# compose file publishes the reverb container on localhost:8106.
REVERB_APP_ID=deploy
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8106
REVERB_CLIENT_SCHEME=http
# Optional path prefix (e.g. /ws) for path-routing the websocket on the app's
# own hostname instead of a dedicated one; must match REVERB_SERVER_PATH.
# REVERB_CLIENT_PATH=
